INSTALL EXTENSION vsql_mcp;
CREATE USER mcpuser@'127.0.0.1';
GRANT SELECT, SHOW VIEW ON *.* TO mcpuser@'127.0.0.1';
CREATE SCHEMA mcpsec;
GRANT INSERT, UPDATE, DELETE ON mcpsec.* TO mcpuser@'127.0.0.1';
CREATE TABLE mcpsec.t1 (id INT PRIMARY KEY, name VARCHAR(50));
INSERT INTO mcpsec.t1 VALUES (1, 'alpha'), (2, 'beta'), (3, 'gamma');
CREATE TABLE mcpsec.secret (id INT PRIMARY KEY, password_hash VARCHAR(80), KEY ix_ph (password_hash));
INSERT INTO mcpsec.secret VALUES (1, 'hunter2hash');
CREATE SCHEMA mcpalt;
CREATE TABLE mcpalt.t1 (id INT PRIMARY KEY, tag VARCHAR(30));
INSERT INTO mcpalt.t1 VALUES (1, 'other-schema-row');
CREATE VIEW mcpsec.v_leak AS SELECT id, tag FROM mcpalt.t1;
CREATE VIEW mcpsec.v_secret AS SELECT password_hash FROM mcpsec.secret;
SET GLOBAL vsql_mcp.port = 0;
SET GLOBAL vsql_mcp.vsql_mcp_enabled = ON;
# --- generate a self-signed certificate for this run ---
cert generated
SET GLOBAL vsql_mcp.ssl_port = 0;
# TLS material is read when the listener binds, so cycle the server.
SET GLOBAL vsql_mcp.vsql_mcp_enabled = OFF;
SET GLOBAL vsql_mcp.vsql_mcp_enabled = ON;
# both listeners are bound
SELECT VARIABLE_VALUE > 0 AS http_listening FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'vsql_mcp.http_port';
http_listening
1
SELECT VARIABLE_VALUE > 0 AS https_listening FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'vsql_mcp.https_port';
https_listening
1
# the two listeners are on different ports
ports_differ
1
# --- a full MCP session over HTTPS ---
https_session_issued: PASS
https_tools_list: PASS
https_query_returns_rows: PASS
https_resource_read: PASS
https_session_delete: PASS
# --- the guardrails apply on the TLS listener too ---
https_guardrail_still_applies: PASS
https_origin_check_still_applies: PASS
https_get_405: PASS
# --- plain HTTP still serves while HTTPS is up ---
http_session_issued: PASS
http_tools_list: PASS
http_query_returns_rows: PASS
http_resource_read: PASS
http_session_delete: PASS
# --- a missing certificate file fails closed ---
# HTTPS must not bind, and the plain listener must be unaffected.
SET GLOBAL vsql_mcp.vsql_mcp_enabled = OFF;
SET GLOBAL vsql_mcp.vsql_mcp_enabled = ON;
SELECT VARIABLE_VALUE AS https_port_when_cert_missing
FROM performance_schema.global_status WHERE VARIABLE_NAME = 'vsql_mcp.https_port';
https_port_when_cert_missing
0
http_session_issued: PASS
http_tools_list: PASS
http_query_returns_rows: PASS
http_resource_read: PASS
http_session_delete: PASS
# --- a key that does not match its certificate fails closed ---
# A second key pair is generated, then the first cert is paired with the
# second key. Both files exist and parse; they simply do not belong
# together, which is the mistake an operator actually makes.
SET GLOBAL vsql_mcp.vsql_mcp_enabled = OFF;
SET GLOBAL vsql_mcp.vsql_mcp_enabled = ON;
# DEFECT: the listener binds anyway. The certificate and key are never
# checked against each other, so https_port publishes a port that cannot
# complete a handshake — a broken endpoint that monitoring reads as
# healthy. Pinned here; see the findings.
known_https_binds_with_mismatched_key
1
https_bound_but_handshake_fails: PASS
handshake_error_kind: URLError
# the plain listener is unaffected by the TLS failure
http_session_issued: PASS
http_tools_list: PASS
http_query_returns_rows: PASS
http_resource_read: PASS
http_session_delete: PASS
# --- ssl_port set but no certificate configured: no TLS listener ---
SET GLOBAL vsql_mcp.ssl_cert = '';
SET GLOBAL vsql_mcp.ssl_key = '';
SET GLOBAL vsql_mcp.vsql_mcp_enabled = OFF;
SET GLOBAL vsql_mcp.vsql_mcp_enabled = ON;
SELECT VARIABLE_VALUE AS https_port_without_cert
FROM performance_schema.global_status WHERE VARIABLE_NAME = 'vsql_mcp.https_port';
https_port_without_cert
0
# --- disabling the server drops the TLS listener too ---
SET GLOBAL vsql_mcp.vsql_mcp_enabled = OFF;
SELECT VARIABLE_VALUE AS https_port_after_disable
FROM performance_schema.global_status WHERE VARIABLE_NAME = 'vsql_mcp.https_port';
https_port_after_disable
0
SET GLOBAL vsql_mcp.vsql_mcp_enabled = ON;
SET GLOBAL vsql_mcp.vsql_mcp_enabled = OFF;
SET GLOBAL vsql_mcp.schema = '';
SET GLOBAL vsql_mcp.allowed_tables = '';
SET GLOBAL vsql_mcp.allow_write = OFF;
SET GLOBAL vsql_mcp.require_auth = OFF;
SET GLOBAL vsql_mcp.bearer_token = '';
SET GLOBAL vsql_mcp.max_rows = 1000;
SET GLOBAL vsql_mcp.query_timeout = 30;
SET GLOBAL vsql_mcp.session_ttl = 1800;
SET GLOBAL vsql_mcp.db_url = '';
SET GLOBAL vsql_mcp.ssl_cert = '';
SET GLOBAL vsql_mcp.ssl_key = '';
SET GLOBAL vsql_mcp.ssl_port = 3143;
DROP VIEW mcpsec.v_secret;
DROP VIEW mcpsec.v_leak;
DROP SCHEMA mcpalt;
DROP SCHEMA mcpsec;
DROP USER mcpuser@'127.0.0.1';
UNINSTALL EXTENSION vsql_mcp;
